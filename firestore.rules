rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection doc
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isValidId(taskId) &&
        incoming().keys().hasAll(['id', 'taskCode', 'title', 'projectId', 'status']) &&
        incoming().id is string &&
        incoming().title is string && incoming().title.size() <= 256 &&
        incoming().taskCode is string && incoming().taskCode.size() <= 64 &&
        incoming().projectId is string && incoming().projectId.size() <= 128 &&
        incoming().status is string;
      allow update: if isValidId(taskId) &&
        incoming().id == existing().id &&
        incoming().projectId == existing().projectId;
      allow delete: if isValidId(taskId);
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isValidId(projectId) &&
        incoming().keys().hasAll(['id', 'name']) &&
        incoming().id is string &&
        incoming().name is string && incoming().name.size() <= 256;
      allow update: if isValidId(projectId) &&
        incoming().id == existing().id;
      allow delete: if isValidId(projectId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) &&
        incoming().keys().hasAll(['id', 'name', 'type']) &&
        incoming().name is string && incoming().name.size() <= 256;
      allow update: if isValidId(categoryId);
      allow delete: if isValidId(categoryId);
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId) &&
        incoming().keys().hasAll(['id', 'userId', 'title', 'message']);
      allow update: if isValidId(notificationId);
      allow delete: if isValidId(notificationId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }
  }
}
